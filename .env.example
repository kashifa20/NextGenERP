# Copy to .env and replace every placeholder before using Docker Compose.
POSTGRES_USER=nextgenerp
POSTGRES_PASSWORD=replace-with-a-random-hex-secret
POSTGRES_DB=nextgenerp
POSTGRES_PORT=5432

# Use a random secret of at least 32 characters. Do not reuse the database password.
JWT_SECRET_KEY=replace-with-a-different-random-secret-of-at-least-32-characters

# Comma-separated, explicit browser origins. Do not use '*'.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
